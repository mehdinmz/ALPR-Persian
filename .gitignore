@'
# Python environments
.venv/
venv/
**/.venv/
**/venv/

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Generated datasets and samples
ocr/data/
ocr/Dataset/generated_plates/roya_bold/
detection/Data Samples/

# Generated model artifacts
*.engine
*.onnx
*.onnx.data
ocr/Models/*.keras
ocr/Models/*.h5
ocr/Models/crnn-fa-license-plate-recognition-v2/

# Local secrets
.env
.env.*
!.env.example
'@ | Set-Content -Encoding utf8 .gitignore
# Large local detection models
detection/Models/*.pt
detection/Models/*.onnx
detection/Models/*.engine
